        return hashlib.sha256(self._data.encode('utf-8')).hexdigest()

    @property
    def fingerprint(self):
        return self._hash

    def verify_integrity(self, current_data):
        current_str = json.dumps(current_data, sort_keys=True)
        return hashlib.sha256(current_str.encode('utf-8')).hexdigest() == self._hash


